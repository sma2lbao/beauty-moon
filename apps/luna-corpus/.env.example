# Database
DATABASE_URL=mysql+mysqlconnector://user:password@localhost:3306/luna_corpus

# ChromaDB
CHROMA_DATA_DIR=./data/chroma

# LLM Provider (ollama, ark, doubao)
LLM_PROVIDER=ollama

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Ark (Cloud - OpenAI compatible)
ARK_API_KEY=your-api-key
ARK_MODEL=deepseek-v4-pro-260425

# Doubao (Volcengine)
VOLCENGINE_ACCESS_KEY=your-access-key
VOLCENGINE_SECRET_KEY=your-secret-key
VOLCENGINE_REGION=cn-beijing
DOUBAO_EMBED_MODEL=doubao-embedding-vision-250615

# API
API_HOST=0.0.0.0
API_PORT=8000

# Runtime
APP_ENV=development
AUTO_CREATE_TABLES=false
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:4200

# RAG
RETRIEVAL_TOP_K=5

# Conversation Memory
CONVERSATION_MEMORY_WINDOW=10
CONVERSATION_MAX_TOKENS=4000
CONVERSATION_SUMMARIZE_THRESHOLD=20

# Observability
LOG_LEVEL=INFO
# LOG_FORMAT defaults to json in production, console otherwise
# LOG_FORMAT=console
METRICS_ENABLED=true
